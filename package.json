{
  "name": "arb-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paper-only multi-pool arbitrage radar for Par on Robinhood Chain",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
