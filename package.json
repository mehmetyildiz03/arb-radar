{
  "name": "arb-radar",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Paper-only multi-pool arbitrage radar for Par on Robinhood Chain",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.mjs",
    "check": "npm run typecheck && npm run ui:check && npm test",
    "start": "npm run build && node dist/index.js",
    "watch": "npm run build && node dist/index.js --watch",
    "replay": "npm run build && node scripts/replay.mjs",
    "sequencer": "npm run build && node dist/research/sequencerExperiment.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "dashboard": "npm run build && node dist/dashboard/server.js",
    "dashboard:smoke": "npm run build && node scripts/dashboard-smoke.mjs",
    "ui:check": "node --check dashboard/app.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "par-sdk": "git+https://github.com/pardotfamily/par-sdk.git#f5a5beb9f9efc17eaca0e2edf85648fa02bb2beb",
    "viem": "2.56.9",
    "ws": "8.22.0"
  }
}
